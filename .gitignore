# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-mobile-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# neon CLI (org id, no secrets, but machine-local)
.neon

# typescript
*.tsbuildinfo
next-env.d.ts

# env: keep the template, ignore the real thing
!.env.example


# Agent tooling. Project rules under .claude/ are shared context and ARE
# committed; only machine-local overrides are ignored.
/.claude/settings.local.json
/.claude/*.local.json
# Machine-local: how a dev server is launched depends on the machine.
/.claude/launch.json

# Playwright
/test-results
/playwright-report
/.playwright
