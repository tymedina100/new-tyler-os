# TylerOS environment configuration.
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.

# Postgres connection string. A real Postgres server is required to run the app;
# tests do not need one.
# Matches the local database defined in docker-compose.yml.
DATABASE_URL="postgresql://tyleros:tyleros@localhost:5432/tyleros"

# Tests need nothing here: they run Postgres in-process via PGlite.

# TylerOS collects no telemetry. This switches off the framework's.
NEXT_TELEMETRY_DISABLED=1
