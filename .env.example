# TylerOS environment configuration.
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.

# Postgres connection string.
# Matches the local database defined in docker-compose.yml.
DATABASE_URL="postgresql://tyleros:tyleros@localhost:5432/tyleros"

# Optional. When set, integration tests run against this database instead of the
# in-process PGlite instance. The database is truncated between tests, so point
# it at a throwaway database only.
# TEST_DATABASE_URL="postgresql://tyleros:tyleros@localhost:5432/tyleros_test"
