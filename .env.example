# TylerOS environment configuration.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Verify the result with: pnpm check:env

# ---------------------------------------------------------------------------
# DATABASE_URL — the only variable TylerOS actually requires.
#
# Any PostgreSQL 14+ reached by a standard connection string works. TylerOS is
# provider-agnostic: no hosting provider is referenced anywhere in the code.
#
# Option A — local server (needs Docker or a local PostgreSQL install).
#   docker compose up -d
#   The line below already matches docker-compose.yml.
DATABASE_URL="postgresql://tyleros:tyleros@localhost:5432/tyleros"

# Option B — a remote database (no Docker, no local PostgreSQL, no admin rights).
#   Create a database with any managed PostgreSQL host and paste its connection
#   string here, replacing the line above. Most hosted PostgreSQL requires TLS,
#   which is the standard `sslmode` parameter rather than anything app-specific:
#
#   DATABASE_URL="postgresql://user:password@your-host.example.com:5432/tyleros?sslmode=require"
#
#   Treat the string as a credential. Do not paste it into a commit or an issue.

# ---------------------------------------------------------------------------
# Tests need nothing here. `pnpm test` runs PostgreSQL in-process via PGlite.
# The browser smoke suite (`pnpm test:e2e`) does use DATABASE_URL, and writes to
# it — point it at a development database.

# TylerOS collects no telemetry. This switches off the framework's.
NEXT_TELEMETRY_DISABLED=1
